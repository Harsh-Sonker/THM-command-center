#!/usr/bin/env bash
# thm - TryHackMe Command Center
# Main entry point

set -Eeuo pipefail

# Make the failure mode explicit when the broken Windows Store bash shim is active.
if [[ -n "${BASH:-}" && "${BASH}" == *"Microsoft/WindowsApps/bash.exe" ]]; then
    echo "[!] THM requires a real Bash runtime, not the broken Windows Store bash shim." >&2
    echo "    Use WSL2/Kali Linux or install Git for Windows, then run the tool again." >&2
    echo "    Example: \"C:/Program Files/Git/bin/bash.exe\" -lc 'cd <project-folder> && bash src/thm --help'" >&2
    exit 1
fi

# Determine paths
export THM_DIR="${HOME}/.local/share/thm"
export THM_CORE="${THM_DIR}/core"
export THM_CONFIG_DIR="${HOME}/.config/thm"
export THM_WORKSPACE="${HOME}/TryHackMe"

# Allow dev override
if [[ -n "${THM_DEV_MODE:-}" ]]; then
    THM_CORE="$(pwd)/src/core"
fi

if [[ -z "${THM_DEV_MODE:-}" ]]; then
    if [[ ! -d "$THM_DIR" || ! -d "$THM_CORE" ]]; then
        if [[ "${1:-}" != "init" ]]; then
            echo "[!] THM Command Center is not initialized."
            echo "    Run 'thm init' if installed, or './install.sh' if in source directory."
            exit 1
        fi
    fi
fi

# Pass control to the CLI router
if [[ -f "${THM_CORE}/cli.sh" ]]; then
    bash "${THM_CORE}/cli.sh" "$@"
else
    echo "Error: cli.sh not found in ${THM_CORE}"
    exit 1
fi
